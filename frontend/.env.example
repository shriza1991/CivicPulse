# Nivaran Frontend Environment Variables
# In local development, the Vite dev server proxies to http://localhost:8000/api
# In production on Vercel, point to your deployed Render backend:
VITE_API_BASE_URL=https://nivaran-backend.onrender.com/api

# Feature Flags
VITE_ENABLE_EVALUATION=false

# Optional WhatsApp Contact Number (for direct bot dispatch)
VITE_WHATSAPP_NUMBER=+14155238886
