# ==============================================================================
# NIVARAN — COMMUNITY DEMAND INTELLIGENCE (.env.example)
# Track 1: AI for Digital Public Infrastructure & Governance
# ==============================================================================

# ─── 1. CORE APPLICATION & ENVIRONMENT ────────────────────────────────────────
ENVIRONMENT=production
FRONTEND_ORIGIN=http://localhost:5173,https://nivaran.vercel.app
APP_BASE_URL=https://nivaran-backend.onrender.com
LOG_LEVEL=info

# ─── 2. DATABASE CONFIGURATION (Neon Serverless PostgreSQL) ───────────────────
# Production Target: Neon PostgreSQL with SSL enabled
DATABASE_URL=postgresql://neondb_owner:your-neon-password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local / CI testing fallback (defaults to sqlite:///nivaran.db if omitted):
# DATABASE_URL=sqlite:///nivaran.db

# ─── 3. GOOGLE GEMINI AI CONFIGURATION (Mandatory) ────────────────────────────
# Primary Google AI Gemini 2.5 key. Multi-key rotation supported via comma separation.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# ─── 4. SARVAM AI SPEECH-TO-TEXT (Indic Multilingual Voice Intake) ───────────
# Model: saaras:v3 for Hindi, Marathi, Gujarati, Bengali, Tamil, etc.
SARVAM_API_KEY=your-sarvam-api-key-here

# ─── 5. MEDIA ASSET OBJECT STORAGE (Cloudflare R2 / Cloudinary / Local) ───────
# Set to 'cloudinary' or 's3' in production; 'local' for local development & CI.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── 6. AUTHENTICATION & SECURITY ─────────────────────────────────────────────
JWT_SECRET_KEY=nivaran_super_secret_jwt_key_2026_change_in_production!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120

# ─── 7. OPTIONAL NOTIFICATION CHANNELS ────────────────────────────────────────
# SendGrid Email Notifications
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@nivaran.org

# WhatsApp Channel (Twilio Sandbox / Meta Cloud API)
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
